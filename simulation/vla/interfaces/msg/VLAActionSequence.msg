# VLA Action Sequence Message
# Message containing planned sequence of actions generated by LLM

VLAAction[] actions
string status  # PENDING, EXECUTING, COMPLETED, FAILED, CANCELLED
builtin_interfaces/Duration estimated_duration
string safety_level  # LOW, NORMAL, HIGH, CRITICAL

# Constants for status
string PENDING = "PENDING"
string EXECUTING = "EXECUTING"
string COMPLETED = "COMPLETED"
string FAILED = "FAILED"
string CANCELLED = "CANCELLED"

# Constants for safety level
string LOW = "LOW"
string NORMAL = "NORMAL"
string HIGH = "HIGH"
string CRITICAL = "CRITICAL"

# Example:
# actions: [VLAAction with type NAVIGATION, parameters ["location=kitchen"]]
# status: "PENDING"
# estimated_duration: duration(45.0)
# safety_level: "NORMAL"